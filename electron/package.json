{
  "name": "grocery-pos",
  "productName": "نظام البقالة",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "description": "Grocery POS",
  "author": "Grocery POS",
  "build": {
    "appId": "com.grocery.pos",
    "productName": "Grocery POS",
    "files": [
      "electron/**",
      "dist/client/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "نظام البقالة",
      "language": "1025"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}