{
  "name": "grocery-pos",
  "productName": "زيروس",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "description": "Grocery POS",
  "author": "Grocery POS",
  "build": {
    "appId": "com.grocery.pos",
    "productName": "Zeros",
    "files": [
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "dist/client",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/scale",
        "to": "scale"
      }
    ],
    "win": {
      "icon": "electron/build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Zeros-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "electron/build/icon.ico",
      "uninstallerIcon": "electron/build/icon.ico",
      "installerHeaderIcon": "electron/build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "زيروس",
      "language": "1025"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ammarsafaa",
        "repo": "grocery-mate-setup"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}